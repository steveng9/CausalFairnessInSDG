-    & \multicolumn{3}{c}{\textbf{Adult}} & & \multicolumn{3}{c}{\textbf{COMPAS}} \\
-    \cmidrule(lr){2-4} \cmidrule(lr){6-8}
-    Family & FTU & CF & DemPar & & FTU & CF & DemPar \\
-    \midrule
-    Causal GAN / diffusion (fixed DAG) & 0.75 & 4.00 & 8.75 & & 1.33 & 1.67 & 3.33 \\
