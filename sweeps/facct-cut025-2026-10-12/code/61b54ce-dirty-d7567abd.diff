-<title>Fairness Cut Graphs</title>
-<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap">
-<style>
-/* Layout: one reading column; each section is a picker row, a figure on a white plate, then the cut list as text. */
-:root{
-  --bg:#f6f7f9; --surface:#ffffff; --fg:#1d2330; --muted:#5a6475; --rule:#d5dae2; --accent:#2b5fb3;
-  --plate:#ffffff; --chip:#e9edf3;
-  --ftu:#1e9e3f; --cf:#f2b600; --dp:#d93025;
-  --sans:"IBM Plex Sans",system-ui,-apple-system,"Segoe UI",sans-serif; --mono:"IBM Plex Mono",ui-monospace,Menlo,monospace;
-}
-@media (prefers-color-scheme: dark){ :root:not([data-theme="light"]){
-  --bg:#12151b; --surface:#1a1f28; --fg:#e6e9ef; --muted:#9aa4b5; --rule:#2f3745; --accent:#8fb4f5; --plate:#ffffff; --chip:#262d3a; color-scheme:dark } }
-:root[data-theme="dark"]{
-  --bg:#12151b; --surface:#1a1f28; --fg:#e6e9ef; --muted:#9aa4b5; --rule:#2f3745; --accent:#8fb4f5; --plate:#ffffff; --chip:#262d3a; color-scheme:dark }
-body{background:var(--bg);color:var(--fg);font-family:var(--sans);font-size:15px;line-height:1.55}
-.wrap{max-width:1180px;margin:0 auto;padding-inline:20px;padding-block:28px 56px;display:flex;flex-direction:column;gap:30px}
-h1{font-size:26px;font-weight:600;margin:0;text-wrap:balance}
-h2{font-size:19px;font-weight:600;margin:0}
-p{margin:0;max-width:72ch}
-.lede{color:var(--muted)}
-section{display:flex;flex-direction:column;gap:14px;border-top:1px solid var(--rule);padding-top:22px}
-.pick{display:flex;flex-wrap:wrap;gap:8px;align-items:center}
-.pick span.lab{font-size:12px;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);margin-right:4px;min-width:64px}
-button.opt{font:inherit;font-size:13.5px;padding:5px 11px;border-radius:6px;border:1px solid var(--rule);background:var(--surface);color:var(--fg);cursor:pointer}
-button.opt[aria-pressed="true"]{background:var(--accent);border-color:var(--accent);color:var(--bg);font-weight:500}
-button.opt:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
-.plate{background:var(--plate);border:1px solid var(--rule);border-radius:8px;padding:10px;overflow-x:auto}
-.plate img{display:block;width:100%;min-width:680px;height:auto}
-.roles{display:grid;grid-template-columns:max-content 1fr;gap:4px 14px;font-size:13.5px}
-.roles dt{color:var(--muted)} .roles dd{margin:0;font-family:var(--mono);font-size:12.5px;min-width:0;overflow-wrap:anywhere}
-.cuts{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:14px}
