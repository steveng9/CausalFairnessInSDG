# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# Environments
.venv/
venv/
env/
.conda/

# Jupyter
.ipynb_checkpoints/

# Data / results (often large or sensitive) -- anchored to repo root so this
# doesn't also match src/causal_fairness_sdg/data/ (the actual package code)
/data/
*.csv
*.parquet
*.pkl
results/
outputs/
experiments.db
# ...except the flat result tables the paper reads (see report/data/README.md)
!/report/data/*.csv
!/report/data/facct/**/*.csv
# Sweep working state: per-shard databases, synthetic tables, locks, raw
# scores. Large, rewritten while a sweep runs; `scripts/collect_results.py`
# folds what the paper needs into report/data/facct/.
/sweeps/*/db/
/sweeps/*/synth/
/sweeps/*/locks/
/sweeps/*/invalid-*/
# 280 MB, rebuilt by `baselines/facct_bench.py collect`
/report/data/facct/angelozzi_mitigators.csv
# 150 MB, rebuilt by `scripts/mama_mia.py --by-group --collect-to ...`;
# mama_mia_group_summary.csv (committed) averages it over seeds
/report/data/facct/mama_mia_group.csv
# 130 MB, rebuilt by `scripts/release_arms.py collect --arm recipients`;
# arm_recipients.csv.gz (committed) is the same table
/report/data/facct/arm_recipients.csv
# release_arms.py working state (rows, predictions, re-sampled tables; 2 GB),
# folded into report/data/facct/arm_*.csv by `collect`
/sweeps/arms-*/
# The lambda batches' dirty-tree diffs are 53 MB each (report CSVs and staged
# manuscript deletions); they change no file under src/, so the generator
# code is commit 4d04cba (sweep notes §21.1)
/sweeps/facct-tfg-lam*/code/
/sweeps/*/fairpfn_baseline/inputs/
/sweeps/*/fairpfn_baseline/preds/
/sweeps/*/preds/
/sweeps/*/worker-*.log
/sweeps/*.log
/sweeps/*/*.out
manuscript/build/
*.partial-bak
# sqlite's write-ahead/rollback sidecars, present while a batch is running
experiments.db-journal
experiments.db-wal
experiments.db-shm

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp
logs/

# Upstream baseline clone (2.3 GB of shipped synthetic data) and its outputs.
baselines/dp-fair-intervention-benchmark/
baselines/output/
baselines/logs/
baselines/facct_data/
baselines/facct_output/
